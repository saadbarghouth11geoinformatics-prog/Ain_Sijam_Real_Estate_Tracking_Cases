  "tracking_workflow": [
    {
      "order": "01",
      "title_ar": "اعتماد الأصل ونطاق الأرض",
      "description_ar": "تسجيل رقم القطعة، الحدود، المالك/المطور، قرار التخصيص، والاستخدام المعتمد."
    },
    {
      "order": "02",
      "title_ar": "الفحص الجغرافي وخط الأساس",
      "description_ar": "تثبيت حدود منطقة الاهتمام وحفظ صورة مرجعية مؤرخة وحساب حالة الأرض قبل التنفيذ."
    },
    {
      "order": "03",
      "title_ar": "المخطط والتصاريح",
      "description_ar": "ربط المخطط العام، تقسيم القطع، اشتراطات الارتفاع، المساحات الخضراء، وتصاريح الجهات الحكومية."
    },
    {
      "order": "04",
      "title_ar": "تجهيز الموقع والبنية الأساسية",
      "description_ar": "رصد التسوية والحفر والطرق المؤقتة وشبكات المياه والطاقة والصرف والاتصالات."
    },
    {
      "order": "05",
      "title_ar": "الإنشاء ونسب الإنجاز",
      "description_ar": "قياس تغير المساحة المبنية والطرق والمرافق وربط كل لقطة بتقرير المقاول والمستخلصات."
    },
    {
      "order": "06",
      "title_ar": "الاختبارات والتسليم",
      "description_ar": "توثيق اكتمال المباني والمرافق وشهادات الفحص والسلامة والاستلام الابتدائي والنهائي."
    },
    {
      "order": "07",
      "title_ar": "التشغيل والمراقبة",
      "description_ar": "مقارنة الأصل المنفذ بالمخطط، تسجيل الانحرافات، ومتابعة التوسعات أو تغيرات الاستخدام."
    }
  ],
